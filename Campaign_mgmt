</tbody>
</table>
</div>
</section>
<section>
<h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">Create New Campaign</h3>
<div class="bg-background-light dark:bg-background-dark p-6 rounded-lg border border-primary/20 dark:border-primary/30 space-y-6">
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div>
<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="campaign-name">Campaign Name</label>
<input class="w-full p-3 rounded-lg border border-primary/20 dark:border-primary/30 bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:ring-primary focus:border-primary" id="campaign-name" placeholder="Enter campaign name" type="text"/>
</div>
<div>
<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="campaign-type">Campaign Type</label>
<select class="w-full p-3 rounded-lg border border-primary/20 dark:border-primary/30 bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 focus:ring-primary focus:border-primary" id="campaign-type">
<option>Select type</option>
<option>Public Service Announcement</option>
<option>Educational Workshop</option>
<option>Community Outreach</option>
</select>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div>
<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="start-date">Start Date</label>
<input class="w-full p-3 rounded-lg border border-primary/20 dark:border-primary/30 bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 focus:ring-primary focus:border-primary" id="start-date" type="date"/>
</div>
<div>
<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="end-date">End Date</label>
<input class="w-full p-3 rounded-lg border border-primary/20 dark:border-primary/30 bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 focus:ring-primary focus:border-primary" id="end-date" type="date"/>
</div>
</div>
<div>
<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="campaign-description">Campaign Description</label>
<textarea class="w-full p-3 rounded-lg border border-primary/20 dark:border-primary/30 bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:ring-primary focus:border-primary" id="campaign-description" placeholder="Enter campaign description" rows="4"></textarea>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div>
<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="target-audience">Target Audience</label>
<select class="w-full p-3 rounded-lg border border-primary/20 dark:border-primary/30 bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 focus:ring-primary focus:border-primary" id="target-audience">
<option>Select audience</option>
<option>General Public</option>
<option>Schools</option>
<option>Healthcare Workers</option>
</select>
</div>
<div>
<label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="communication-channels">Communication Channels</label>
<select class="w-full p-3 rounded-lg border border-primary/20 dark:border-primary/30 bg-background-light dark:bg-background-dark text-slate-800 dark:text-slate-200 focus:ring-primary focus:border-primary" id="communication-channels">
<option>Select channels</option>
<option>SMS</option>
<option>Posters</option>
<option>In-app Notifications</option>
</select>
</div>
</div>
<div>
<h4 class="text-lg font-bold text-slate-900 dark:text-white mb-4">Campaign Materials</h4>
<div class="border-2 border-dashed border-primary/40 dark:border-primary/50 rounded-lg p-10 text-center">
<p class="text-slate-800 dark:text-white mb-2">Upload Campaign Materials</p>
<p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Drag and drop files here or browse to upload</p>
<button class="px-4 py-2 bg-primary/20 dark:bg-primary/30 text-slate-800 dark:text-white font-semibold rounded-lg hover:bg-primary/30 dark:hover:bg-primary/40 transition-colors" type="button">
                  Browse Files
                </button>
</div>
</div>
<div class="flex justify-end">
<button class="px-6 py-3 bg-primary text-white font-bold rounded-lg hover:bg-opacity-90 transition-colors" type="submit">
                Create Campaign
              </button>
</div>
</div>
</section>
</div>
</main>
